# Copy this file to .env and fill in the values from your Firebase project
# (Firebase Console -> Project settings -> General -> Your apps -> SDK setup and configuration).
# .env is gitignored, so these values never get committed.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Groq API key for Jack, the AI assistant (console.groq.com). Server-only: no VITE_ prefix,
# so it is never bundled into the site. Set it in Vercel too.
GROQ_API_KEY=
